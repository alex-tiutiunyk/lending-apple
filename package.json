{
  "name": "iphone-concept-landing",
  "private": true,
  "version": "0.1.0",
  "description": "Unofficial animated concept landing page for a next-generation phone. Portfolio project, not affiliated with Apple.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && stylelint \"src/**/*.scss\" && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "points": "node scripts/generate-apple-points.mjs",
    "check:cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.app.json src",
    "check:unused": "knip"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "knip": "^6.41.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "~5.8",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
